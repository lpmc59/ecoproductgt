# .env.example — plantilla para EcoProduct
# Copiar a `.env` y rellenar. El archivo .env NUNCA se commitea (está en .gitignore).

# Puerto HTTP del servidor Express (default 6001).
PORT=6001

# Secret para firmar las cookies de sesión.
# OBLIGATORIO en producción. Generar un valor aleatorio largo, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# Credenciales del usuario admin inicial.
# Se usan SOLO la primera vez que arranca la app (cuando se crea data/db.json).
# Si data/db.json ya existe, estos valores se ignoran: cambiar la contraseña
# desde el panel /admin/users.
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=cambia-esto-antes-del-primer-arranque
