<%- include('partials/header') %>

<style>
  .casos-exito { margin-top: 3rem; }
  .caso-card { background: var(--gray-50); border-radius: 14px; padding: 1.5rem; margin-bottom: 1rem; border-left: 4px solid var(--green-500); }
  .caso-card h4 { color: var(--green-800); font-size: 1rem; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
  .caso-card p { font-size: 0.9rem; color: var(--gray-600); line-height: 1.7; }

  .tam-sam-som { margin-top: 3rem; }
  .tam-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-bottom: 2rem; }
  .tam-card { background: var(--white); border-radius: 14px; padding: 1.5rem; border: 1px solid var(--gray-200); text-align: center; transition: all 0.3s; }
  .tam-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); }
  .tam-card .tam-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; margin-bottom: 0.5rem; }
  .tam-card:nth-child(1) .tam-label { color: #2563eb; }
  .tam-card:nth-child(2) .tam-label { color: #7c3aed; }
  .tam-card:nth-child(3) .tam-label { color: var(--green-600); }
  .tam-card .tam-value { font-size: 2.25rem; font-weight: 800; color: var(--gray-900); line-height: 1; margin-bottom: 0.5rem; }
  .tam-card:nth-child(1) .tam-value { color: #2563eb; }
  .tam-card:nth-child(2) .tam-value { color: #7c3aed; }
  .tam-card:nth-child(3) .tam-value { color: var(--green-600); }
  .tam-card .tam-desc { font-size: 0.82rem; color: var(--gray-500); line-height: 1.5; }

  .mercado-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .mercado-item { background: var(--green-50); border-radius: 12px; padding: 1.25rem; }
  .mercado-item .mercado-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--green-700); font-weight: 700; margin-bottom: 0.35rem; }
  .mercado-item .mercado-value { font-size: 0.9rem; color: var(--gray-700); font-weight: 600; }
  .fuentes-box { background: var(--gray-50); border-radius: 12px; padding: 1rem 1.25rem; font-size: 0.85rem; color: var(--gray-500); }
  .fuentes-box strong { color: var(--gray-700); }

  @media (max-width: 768px) {
    .tam-grid { grid-template-columns: 1fr; }
  }
</style>

<section class="section" style="padding-top:3rem;">
  <div class="section-container">
    <div style="margin-bottom:2rem;">
      <a href="/" style="color:var(--green-600);text-decoration:none;font-size:0.9rem;"><i class="fas fa-arrow-left"></i> Volver al Inicio</a>
    </div>
    <div class="product-detail">
      <div class="product-detail-img">
        <% if (product.productImage) { %>
        <img src="<%= product.productImage %>" alt="<%= product.name %>">
        <% } else { %>
        <div style="text-align:center;color:var(--gray-400);"><i class="fas fa-flask" style="font-size:5rem;margin-bottom:1rem;display:block;"></i><span style="font-size:0.9rem;">Imagen próximamente</span></div>
        <% } %>
      </div>
      <div class="product-detail-info">
        <h1><%= product.name %></h1>
        <div class="detail-subtitle"><%= product.subtitle %></div>
        <p class="detail-desc"><%= product.description %></p>
        <div class="product-format" style="margin-bottom:1.5rem;"><i class="fas fa-box"></i> <%= product.format %></div>
        <% if (product.benefits && product.benefits.length > 0) { %>
        <h4 style="color:var(--green-900);margin-bottom:0.75rem;">Beneficios</h4>
        <ul class="benefits-list">
          <% product.benefits.forEach(b => { %>
          <li><%= b %></li>
          <% }); %>
        </ul>
        <% } %>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
          <button class="btn btn-green" onclick="showModal('pedidos')"><i class="fas fa-cart-shopping"></i> Hacer Pedido</button>
          <button class="btn btn-outline" style="border-color:var(--green-600);color:var(--green-600);" onclick="showModal('precios')"><i class="fas fa-tags"></i> Ver Precio</button>
          <button class="btn btn-outline" style="border-color:var(--green-600);color:var(--green-600);" onclick="showModal('whatsapp')"><i class="fab fa-whatsapp"></i> WhatsApp</button>
        </div>
      </div>
    </div>

    <%
      // Helper para renderizar texto multilínea como párrafos
      function renderParagraphs(s){
        if (!s) return '';
        return s.split(/\n\n+/).map(function(p){
          return '<p>' + p.replace(/\n/g, '<br>') + '</p>';
        }).join('');
      }
      var hasFaseII = product.justificacion || product.alcancePreliminar || product.loQueBusca || product.loQueValida || product.loQueNoPromete;
    %>

    <% if (hasFaseII) { %>
    <div class="fase-ii-blocks">
      <% if (product.justificacion) { %>
      <div class="block-card block-justificacion">
        <h3><i class="fas fa-lightbulb"></i> Justificación del concepto</h3>
        <div class="block-body"><%- renderParagraphs(product.justificacion) %></div>
      </div>
      <% } %>

      <% if (product.alcancePreliminar) { %>
      <div class="block-card block-alcance">
        <h3><i class="fas fa-clipboard-list"></i> Alcance preliminar</h3>
        <div class="block-body"><%- renderParagraphs(product.alcancePreliminar) %></div>
      </div>
      <% } %>

      <% if (product.loQueBusca) { %>
      <div class="block-card block-busca">
        <h3><i class="fas fa-bullseye"></i> Lo que busca</h3>
        <div class="block-body"><%- renderParagraphs(product.loQueBusca) %></div>
      </div>
      <% } %>

      <% if (product.loQueValida) { %>
      <div class="block-card block-valida">
        <h3><i class="fas fa-vial"></i> Lo que queda sujeto a validación</h3>
        <div class="block-body"><%- renderParagraphs(product.loQueValida) %></div>
      </div>
      <% } %>

      <% if (product.loQueNoPromete) { %>
      <div class="block-card block-nopromete">
        <h3><i class="fas fa-circle-exclamation"></i> Lo que no debe prometer</h3>
        <div class="block-body"><%- renderParagraphs(product.loQueNoPromete) %></div>
      </div>
      <% } %>
    </div>
    <style>
      .fase-ii-blocks { margin-top: 3rem; display: flex; flex-direction: column; gap: 1.25rem; }
      .block-card { background: var(--white); border: 1px solid var(--gray-200); border-radius: 14px; padding: 1.5rem 1.75rem; border-left: 4px solid var(--green-500); }
      .block-card h3 { color: var(--green-900); font-size: 1.1rem; margin-bottom: 0.9rem; display: flex; align-items: center; gap: 0.55rem; }
      .block-card h3 i { color: var(--green-600); }
      .block-card .block-body p { font-size: 0.95rem; color: var(--gray-700); line-height: 1.75; margin-bottom: 0.85rem; }
      .block-card .block-body p:last-child { margin-bottom: 0; }
      .block-nopromete { border-left-color: #d97706; background: #fffbeb; }
      .block-nopromete h3 { color: #92400e; }
      .block-nopromete h3 i { color: #d97706; }
      .block-valida { border-left-color: #2563eb; background: #eff6ff; }
      .block-valida h3 { color: #1e3a8a; }
      .block-valida h3 i { color: #2563eb; }
    </style>
    <% } %>

    <% if (product.casosExito && product.casosExito.length > 0) { %>
    <!-- CASOS DE ÉXITO -->
    <div class="casos-exito">
      <div class="section-header" style="text-align:left;margin-bottom:1.5rem;">
        <h2><i class="fas fa-trophy" style="color:var(--green-600);"></i> Casos de Éxito y Referencias</h2>
        <p style="margin:0;">Referentes internacionales que validan esta solución</p>
      </div>
      <% product.casosExito.forEach(caso => { %>
      <div class="caso-card">
        <h4><i class="fas fa-building"></i> <%= caso.empresa %></h4>
        <p><%= caso.descripcion %></p>
      </div>
      <% }); %>
    </div>
    <% } %>

    <% if (product.tamSamSom) { %>
    <!-- TAM SAM SOM -->
    <div class="tam-sam-som">
      <div class="section-header" style="text-align:left;margin-bottom:1.5rem;">
        <h2><i class="fas fa-chart-pie" style="color:var(--green-600);"></i> Análisis de Mercado: TAM, SAM, SOM</h2>
        <p style="margin:0;">Dimensionamiento del mercado objetivo en Guatemala</p>
      </div>

      <div class="tam-grid">
        <div class="tam-card">
          <div class="tam-label">TAM - Mercado Total</div>
          <div class="tam-value"><%= product.tamSamSom.tam.valor %></div>
          <div class="tam-desc"><%= product.tamSamSom.tam.descripcion %></div>
        </div>
        <div class="tam-card">
          <div class="tam-label">SAM - Mercado Alcanzable</div>
          <div class="tam-value"><%= product.tamSamSom.sam.valor %></div>
          <div class="tam-desc"><%= product.tamSamSom.sam.descripcion %></div>
        </div>
        <div class="tam-card">
          <div class="tam-label">SOM - Mercado Objetivo</div>
          <div class="tam-value"><%= product.tamSamSom.som.valor %></div>
          <div class="tam-desc"><%= product.tamSamSom.som.descripcion %></div>
        </div>
      </div>

      <div class="section-header" style="text-align:left;margin-bottom:1rem;">
        <h3 style="font-size:1.15rem;color:var(--green-900);">Precio Benchmark y Tamaño de Mercado Inicial</h3>
      </div>
      <div class="mercado-grid">
        <div class="mercado-item">
          <div class="mercado-label">Precio Benchmark</div>
          <div class="mercado-value"><%= product.tamSamSom.precio %></div>
        </div>
        <div class="mercado-item">
          <div class="mercado-label">Frecuencia</div>
          <div class="mercado-value"><%= product.tamSamSom.frecuencia %></div>
        </div>
        <div class="mercado-item" style="grid-column: 1 / -1;">
          <div class="mercado-label">Tamaño de Mercado Inicial (SOM)</div>
          <div class="mercado-value" style="font-size:1.1rem;color:var(--green-700);"><%= product.tamSamSom.mercado %></div>
        </div>
      </div>

      <div class="fuentes-box">
        <strong><i class="fas fa-book"></i> Fuentes:</strong> <%= product.tamSamSom.fuentes %>
      </div>
    </div>
    <% } %>

  </div>
</section>

<%- include('partials/footer') %>
