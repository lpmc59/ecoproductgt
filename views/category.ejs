<%- include('partials/header') %>

<section class="section" style="padding-top:3rem;">
  <div class="section-container">
    <div style="margin-bottom:2rem;">
      <a href="/" style="color:var(--green-600);text-decoration:none;font-size:0.9rem;"><i class="fas fa-arrow-left"></i> Volver al Inicio</a>
    </div>
    <div class="section-header" style="text-align:left;">
      <h2><i class="fas <%= category.icon %>" style="color:var(--green-600);"></i> <%= category.name %></h2>
      <p style="margin:0;"><%= category.description %></p>
    </div>

    <% if (products.length === 0) { %>
    <div style="text-align:center;padding:4rem 2rem;background:var(--gray-50);border-radius:16px;">
      <i class="fas fa-flask" style="font-size:3rem;color:var(--gray-300);margin-bottom:1rem;display:block;"></i>
      <h3 style="color:var(--gray-700);margin-bottom:0.5rem;">Productos en Desarrollo</h3>
      <p style="color:var(--gray-500);">Próximamente agregaremos productos a esta categoría.</p>
    </div>
    <% } else { %>
    <div class="products-grid">
      <% products.forEach(product => { %>
      <a href="/producto/<%= product.id %>" class="product-card" style="text-decoration:none;color:inherit;">
        <div class="product-card-img">
          <img src="<%= product.productImage %>" alt="<%= product.name %>">
        </div>
        <div class="product-card-body">
          <h3><%= product.name %></h3>
          <div class="product-subtitle"><%= product.subtitle %></div>
          <p><%= product.description %></p>
          <div class="product-format"><i class="fas fa-box"></i> <%= product.format %></div>
        </div>
      </a>
      <% }); %>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
