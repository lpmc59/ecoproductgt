  <!-- =============== HERO =============== -->
  <section class="bv-hero" id="inicio" aria-labelledby="bv-hero-title">
    <div class="bv-container bv-hero__grid">
      <div>
        <p class="bv-eyebrow">Microbiología aplicada</p>
        <h1 class="bv-hero__title" id="bv-hero-title">
