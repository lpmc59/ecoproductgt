<%
  var stages = [
    { n: 1, tag: 'Visita técnica',  title: 'Diagnóstico', text: 'Revisamos el agua que recibe la planta, identificamos el problema principal y definimos el punto de aplicación.', alt: 'Ilustración de tubo de ensayo, tanque y lista de revisión' },
    { n: 2, tag: 'Prueba inicial',  title: 'Piloto',      text: 'Entregamos BacVita para la prueba, acompañamos el arranque y capacitamos al operador.', alt: 'Ilustración de una botella turquesa vertiendo líquido en un recipiente', chip: 'BacVita Start' },
    { n: 3, tag: 'Bitácora',        title: 'Seguimiento', text: 'Registramos olores, lodos, grasas y DBO₅/DQO, y ajustamos la aplicación cuando hace falta.', alt: 'Ilustración de bitácora con gráfica, botella y frascos de muestra' },
    { n: 4, tag: 'Reporte en PDF',  title: 'Reporte',     text: 'Resultados del piloto con lo observado en la planta y recomendación de continuidad.', alt: 'Ilustración de un reporte con gráfica de barras y marca de aprobado' },
    { n: 5, tag: 'Plan mensual',    title: 'Continuidad', text: 'Mantenimiento mensual: reposición según consumo real y seguimiento técnico para sostener el tratamiento.', alt: 'Ilustración de calendario y botella con flechas de ciclo' }
  ];
%>
<section class="bv-section bv-process" id="servicio" aria-labelledby="bv-process-title">
  <div class="bv-container">
    <div class="bv-head">
      <p class="bv-kicker">El servicio</p>
      <h2 class="bv-head__title" id="bv-process-title">Del diagnóstico al mantenimiento mensual.</h2>
      <p class="bv-head__desc">
        BacVita no termina con la primera aplicación. Cada etapa deja registro
        y sirve para decidir la siguiente.
      </p>
    </div>

    <div class="bv-route">
      <svg class="bv-route__path" viewBox="0 0 1000 140" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="bv-route__trail" d="M0,70 C50,70 50,28 100,28 C200,28 200,112 300,112 C400,112 400,28 500,28 C600,28 600,112 700,112 C800,112 800,28 900,28 C950,28 950,70 1000,70"/>
        <path class="bv-route__line" d="M0,70 C50,70 50,28 100,28 C200,28 200,112 300,112 C400,112 400,28 500,28 C600,28 600,112 700,112 C800,112 800,28 900,28 C950,28 950,70 1000,70"/>
      </svg>

      <ol class="bv-route__steps">
        <% stages.forEach(function (s) { %>
          <li class="bv-step bv-step--<%= s.n % 2 ? 'up' : 'down' %>">
            <span class="bv-step__node" aria-hidden="true"><%= s.n %></span>
            <div class="bv-step__body">
              <span class="bv-step__media">
                <img src="/assets/bacvita/bacvita-step-<%= s.n %>.png" alt="<%= s.alt %>" loading="lazy" decoding="async" width="1181" height="1181">
              </span>
              <p class="bv-step__tag">Etapa <%= s.n %> · <%= s.tag %></p>
              <h3 class="bv-step__title"><%= s.title %></h3>
              <p class="bv-step__text"><%= s.text %></p>
              <% if (s.chip) { %><span class="bv-step__chip"><%= s.chip %></span><% } %>
            </div>
          </li>
        <% }) %>
      </ol>
    </div>

    <div class="bv-bento bv-bento--maint">
      <article class="bv-tile bv-tile--maint">
        <p class="bv-kicker">Mantenimiento mensual</p>
        <h3>Tu PTAR con seguimiento, no con una sola aplicación.</h3>
        <ul class="bv-checks">
          <li>Reposición de BacVita según consumo real</li>
          <li>Dosis de mantenimiento definida en el seguimiento</li>
          <li>Revisión de la bitácora operativa</li>
          <li>Ajustes del punto y la frecuencia de aplicación</li>
          <li>Seguimiento técnico</li>
        </ul>
      </article>
      <div class="bv-tile bv-tile--report">
        <div class="bv-report" role="img" aria-label="Estructura de ejemplo del reporte técnico mensual: resumen, bitácora, dosis aplicada, olores, lodos y grasas, DBO5 y DQO, y ajustes">
          <div class="bv-report__head"><span>Reporte técnico mensual</span><span>PDF</span></div>
          <div class="bv-report__row"><span>Resumen</span><i></i></div>
          <div class="bv-report__row"><span>Bitácora</span><i></i></div>
          <div class="bv-report__row"><span>Dosis aplicada</span><i class="bv-short"></i></div>
          <div class="bv-report__row"><span>Olores, lodos, grasas</span><i></i></div>
          <div class="bv-report__row"><span>DBO<sub>5</sub> / DQO</span><i class="bv-short"></i></div>
          <div class="bv-report__row"><span>Ajustes</span><i></i></div>
          <p class="bv-report__foot">Estructura de ejemplo</p>
        </div>
      </div>
    </div>
  </div>
</section>
