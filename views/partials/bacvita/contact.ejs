<%
  // Datos de contacto editables desde /admin/content (siteContent en data/db.json).
  var email = (content && content.contactEmail) || '';
  var wa = (content && content.whatsappNumber) ? String(content.whatsappNumber).replace(/[^\d]/g, '') : '';
%>
<section class="bv-section bv-contact" id="contacto" aria-labelledby="bv-contact-title">
  <div class="bv-container">
    <div class="bv-contact__block">
      <div class="bv-contact__main">
        <p class="bv-kicker bv-kicker--light">Contacto</p>
        <h2 class="bv-contact__title" id="bv-contact-title">Agenda una reunión técnica para evaluar tu planta.</h2>
        <p class="bv-contact__desc">
          Cuéntanos qué tipo de PTAR tienes y qué problema ves. Te respondemos
          con una propuesta de diagnóstico.
        </p>
        <dl class="bv-contact__list">
          <% if (email) { %>
            <div><dt>Correo</dt><dd><a href="mailto:<%= email %>"><%= email %></a></dd></div>
          <% } %>
          <% if (wa) { %>
            <div><dt>WhatsApp</dt><dd><a href="https://wa.me/<%= wa %>" rel="noopener" target="_blank"><%= content.whatsappNumber %></a></dd></div>
          <% } %>
          <div><dt>Horario</dt><dd>Lunes a viernes · 8:00 a 17:00</dd></div>
        </dl>
      </div>

      <form class="bv-form" id="bv-form" novalidate data-to="<%= email %>" aria-describedby="bv-form-help">
        <p class="bv-form__help" id="bv-form-help">Los campos con * son obligatorios. Al enviar se abre tu programa de correo con el mensaje listo.</p>
        <div class="bv-form__two">
          <div class="bv-field">
            <label for="bv-f-nombre">Nombre *</label>
            <input id="bv-f-nombre" name="nombre" autocomplete="name" data-bv-required aria-describedby="bv-f-nombre-error">
            <p class="bv-field__error" id="bv-f-nombre-error" hidden>Escribe tu nombre.</p>
          </div>
          <div class="bv-field">
            <label for="bv-f-empresa">Empresa o institución *</label>
            <input id="bv-f-empresa" name="empresa" autocomplete="organization" data-bv-required aria-describedby="bv-f-empresa-error">
            <p class="bv-field__error" id="bv-f-empresa-error" hidden>Escribe el nombre de la empresa o institución.</p>
          </div>
        </div>
        <div class="bv-form__two">
          <div class="bv-field">
            <label for="bv-f-correo">Correo *</label>
            <input id="bv-f-correo" name="correo" type="email" autocomplete="email" inputmode="email" data-bv-required aria-describedby="bv-f-correo-error">
            <p class="bv-field__error" id="bv-f-correo-error" hidden>Escribe un correo válido, por ejemplo nombre@empresa.com.</p>
          </div>
          <div class="bv-field">
            <label for="bv-f-tipo">Tipo de PTAR</label>
            <select id="bv-f-tipo" name="tipo">
              <option>Hospitalaria</option>
              <option>Industrial</option>
              <option>Condominio o parque industrial</option>
              <option>Municipal</option>
              <option>Otra</option>
            </select>
          </div>
        </div>
        <div class="bv-field">
          <label for="bv-f-mensaje">Qué problema ves *</label>
          <textarea id="bv-f-mensaje" name="mensaje" rows="4" placeholder="Olores, grasas, DBO₅ o DQO altas, lodos…" data-bv-required aria-describedby="bv-f-mensaje-error"></textarea>
          <p class="bv-field__error" id="bv-f-mensaje-error" hidden>Cuéntanos brevemente qué pasa en la planta.</p>
        </div>
        <button class="bv-btn bv-btn--dark bv-form__submit" type="submit">Solicitar reunión</button>
        <p class="bv-form__note" id="bv-form-note" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
