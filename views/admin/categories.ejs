<% const pageId = 'categories'; %>
<%- include('../partials/admin-layout') %>

<main class="admin-main">
  <div class="admin-topbar">
    <h1><i class="fas fa-layer-group"></i> Categorías</h1>
    <div class="user-info">
      <span class="user-badge"><i class="fas fa-user"></i> <%= user.username %></span>
    </div>
  </div>
  <div class="admin-content">
    <% if (flash && flash.message) { %>
    <div class="alert alert-<%= flash.type === 'error' ? 'error' : 'success' %>">
      <i class="fas fa-<%= flash.type === 'error' ? 'exclamation-circle' : 'check-circle' %>"></i> <%= flash.message %>
    </div>
    <% } %>

    <% categories.sort((a,b) => a.order - b.order).forEach(cat => { %>
    <div class="admin-card">
      <form method="POST" action="/admin/categories/edit/<%= cat.id %>">
        <h3><i class="fas <%= cat.icon %>"></i> <%= cat.name %></h3>
        <div class="form-row">
          <div class="form-group">
            <label>Nombre</label>
            <input type="text" name="name" value="<%= cat.name %>">
          </div>
          <div class="form-group">
            <label>Icono (Font Awesome class)</label>
            <input type="text" name="icon" value="<%= cat.icon %>" placeholder="fa-house">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Descripción</label>
            <input type="text" name="description" value="<%= cat.description %>">
          </div>
          <div class="form-group">
            <label>Orden</label>
            <input type="number" name="order" value="<%= cat.order %>" min="1">
          </div>
        </div>
        <button type="submit" class="btn-admin btn-save"><i class="fas fa-save"></i> Guardar</button>
      </form>
    </div>
    <% }); %>
  </div>
</main>
</body>
</html>
